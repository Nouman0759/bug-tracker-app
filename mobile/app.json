{
  "expo": {
    "name": "Bug Tracker",
    "slug": "bug-tracker-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourcompany.bugtracker"
    },
    "android": {
      "package": "com.yourcompany.bugtracker",
      "adaptiveIcon": {
        "backgroundColor": "#F8F7FF"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "5afd3d9d-66b4-49fc-ba6d-22d98b765ff9"
      }
    }
  }
}
