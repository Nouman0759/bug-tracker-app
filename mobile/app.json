{
  "expo": {
    "name": "Bug Tracker",
    "slug": "bug-tracker-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourcompany.bugtracker"
    },
    "android": {
      "package": "com.yourcompany.bugtracker",
      "adaptiveIcon": {
        "backgroundColor": "#F8F7FF"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F7FF",
          "imageWidth": 200
        }
      ]
    ]
  }
}